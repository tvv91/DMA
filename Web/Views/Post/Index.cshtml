@using Web.Authorization
@using Microsoft.Extensions.Localization
@using Web
@inject IStringLocalizer<SharedResource> Localizer
<body data-page="post-list">
    <div class="blog-container">
        <div class="blog-post position-relative">
            <div id="spinner" class="post-spinner-overlay d-none">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">@Localizer["Loading"]</span>
                </div>
            </div>
            <div id="post-container"></div>
        </div>
        <div class="blog-side-panel">
            <div class="blog-side-panel-filters">
                <div style="margin-bottom: 20px;">
                    <label for="searchfilter" style="display: block; margin-bottom: 8px; font-weight: 600; color: #495057; font-size: 0.9rem;">
                        🔍 @Localizer["SearchPosts"]
                    </label>
                    <input id="searchfilter" class="form-control" type="search" placeholder="@Localizer["SearchPostsPlaceholder"]">
                </div>
                <label for="categoryfilter" class="mt-2">@Localizer["FilterByCategory"]</label>
                <div class="d-flex gap-2" style="margin-bottom: 16px 0;">
                    <select id="categoryfilter" class="custom-select flex-fill">
                        <option selected value="">@Localizer["AllCategories"]</option>
                        <option value="Developing">@Localizer["Developing"]</option>
                        <option value="Releases">@Localizer["Releases"]</option>
                        <option value="Other">@Localizer["Other"]</option>
                    </select>
                    <input id="yearfilter" class="form-control" placeholder="@Localizer["Year"]" style="max-width: 100px;">
                </div>
                @if (User.IsInRole(RoleNames.Admin))
                {
                <label>
                    <input id="draftfilter" type="checkbox"> @Localizer["ShowOnlyDrafts"]
                </label>
                }
                <hr />
                <div class="blog-tree-view">
                    <label class="mt-2 mb-2" style="font-weight: 600; color: #495057; font-size: 1rem;">
                        📚 @Localizer["BlogArchive"]
                    </label>
                    <div id="blog-tree" class="blog-tree"></div>
                </div>
            </div>
        </div>
        <div style="grid-column: 1 / -1;">
            <nav aria-label="@Localizer["PostsPagination"]">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>
    @section Scripts {
        <script src="~/js/post.js"></script>
    }
</body>
