@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Web
@inject IStringLocalizer<SharedResource> Localizer
@using Web.Authorization
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
    <head>
        <meta name="viewport" content="width=device-width"/>
        <meta http-equiv='cache-control' content='no-cache'>
        <meta http-equiv='expires' content='0'>
        <meta http-equiv='pragma' content='no-cache'>
        <meta name="request-verification-token" content="@antiforgeryToken">
        <title>@Localizer["SiteTitle"]</title>
        <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
        <link rel="stylesheet" href="~/lib/jqueryui/themes/base/jquery-ui.min.css" />
        <link rel="stylesheet" href="~/lib/dropzone/dropzone.min.css" />
        <link rel="stylesheet" href="~/css/shared.css" />
        @{
            var path = Context.Request.Path.Value?.ToLower() ?? "";
            if (path.Contains("/album"))
            {
                <link rel="stylesheet" href="~/css/album.css" />
            }
            else if (path.Contains("/equipment"))
            {
                <link rel="stylesheet" href="~/css/equipment.css" />
                <link rel="stylesheet" href="~/css/album.css" />
            }
            else if (path.Contains("/post") || path == "/")
            {
                <link rel="stylesheet" href="~/css/post.css" />
            }
            else if (path.Contains("/statistic"))
            {
                <link rel="stylesheet" href="~/css/statistic.css" />
            }
        }
        <script src="/lib/jquery/jquery.min.js"></script>
        <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/lib/jqueryui/jquery-ui.js"></script>
        <script src="/lib/microsoft-signalr/signalr.js"></script>
        <script src="/lib/dropzone//dropzone.min.js"></script>
        <script src="/js/hubconnection.js"></script>
        <script src="/lib/dompurify/purify.min.js"></script>
        <script>
            window.getRequestVerificationToken = () =>
                document.querySelector('meta[name="request-verification-token"]')?.content || "";

            $(document).ready(() => {
                window.location.pathname === "/"
                    ? $("#default").css("font-weight", "bold")
                    : $("#menu a[href='" + window.location.pathname + "']").css("font-weight", "bold");
            });
        </script>
    </head>
    <body>
    @{
        var isStatisticPage = Context.Request.Path.Equals("/statistic", StringComparison.OrdinalIgnoreCase);
    }
    <div id="page-loading-overlay" class="page-loading-overlay @(isStatisticPage ? "" : "hidden")" role="status" aria-live="polite" aria-label="@Localizer["LoadingStatistics"]">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
    </div>
    <div class="container">
        <h4 class="text-center">@Localizer["Welcome"]</h4>
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm px-4">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav" id="menu">
                    <li class="nav-item">
                        <a class="nav-link" id="default" href="/">@Localizer["LastNews"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/album">@Localizer["Albums"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/equipment">@Localizer["Equipment"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/statistic">@Localizer["Statistic"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/about">@Localizer["AboutProject"]</a>
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <form asp-controller="Account" asp-action="SetLanguage" method="post" class="d-flex align-items-center gap-1">
                    @Html.AntiForgeryToken()
                    <label for="culture-select" class="visually-hidden">@Localizer["Language"]</label>
                    <select id="culture-select" name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="en" selected="@(CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase))">EN</option>
                        <option value="ru" selected="@(CultureInfo.CurrentUICulture.Name.StartsWith("ru", StringComparison.OrdinalIgnoreCase))">RU</option>
                        <option value="uk" selected="@(CultureInfo.CurrentUICulture.Name.StartsWith("uk", StringComparison.OrdinalIgnoreCase))">UK</option>
                    </select>
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                </form>
                <!--TODO: Implement later-->
                <!--<input class="form-control" type="search" placeholder="Search anything">-->
                <div class="d-flex align-items-center gap-3 px-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-muted small">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link nav-link p-0">@Localizer["Logout"]</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link nav-link p-0" data-login-modal>@Localizer["Login"]</button>
                    }
                </div>
                @if (User.IsInRole(RoleNames.Admin))
                {
                <div class="dropdown dropstart">
                    <i id="add-button" class="fa fa-plus-square fa-2xl fa-pull-left addbutton" style="cursor:pointer" data-bs-toggle="dropdown"></i>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="../album/create">@Localizer["AddAlbum"]</a>
                        <a class="dropdown-item" href="../equipment/create">@Localizer["AddEquipment"]</a>
                        <a class="dropdown-item" href="../post/new">@Localizer["AddPost"]</a>
                    </div>
                </div>
                }
            </div>
        </nav>
        </div>
        <div class="container">
            @RenderBody()
        </div>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="_LoginModal" />
            <script src="/js/login.js"></script>
        }
    <script>
        window.localization = @Html.Raw(JsonSerializer.Serialize(new
        {
            errorLoadingPosts = Localizer["ErrorLoadingPosts"].Value,
            refreshPageToTryAgain = Localizer["RefreshPageToTryAgain"].Value,
            connectionError = Localizer["ConnectionError"].Value,
            unableToConnect = Localizer["UnableToConnect"].Value,
            noPostsFound = Localizer["NoPostsFound"].Value,
            adjustFilters = Localizer["AdjustFilters"].Value,
            noPostsAvailable = Localizer["NoPostsAvailable"].Value,
            noDataAvailable = Localizer["NoDataAvailable"].Value,
            unknownDate = Localizer["UnknownDate"].Value,
            uncategorized = Localizer["Uncategorized"].Value,
            categories = new
            {
                developing = Localizer["CategoryDeveloping"].Value,
                other = Localizer["CategoryOther"].Value,
                releases = Localizer["CategoryReleases"].Value
            }
        }));

        const pageLoadingOverlay = document.getElementById('page-loading-overlay');

        function hidePageLoadingOverlay() {
            pageLoadingOverlay?.classList.add('hidden');
        }

        function showStatisticsLoadingOverlay() {
            pageLoadingOverlay?.classList.remove('hidden');
        }

        document.addEventListener('DOMContentLoaded', hidePageLoadingOverlay);
        window.addEventListener('pageshow', hidePageLoadingOverlay);
        document.querySelectorAll('a[href]').forEach(link => {
            const linkUrl = new URL(link.href, window.location.origin);
            if (linkUrl.pathname.toLowerCase() === '/statistic') {
                link.addEventListener('click', showStatisticsLoadingOverlay);
            }
        });

        $('#menu a').on('mouseover mouseleave', function (e) {
            if (window.location.pathname !== $(this).attr("href"))  {
                switch (e.type) { 
                    case "mouseover":
                        $(this).css("font-weight", "bold");
                        break;
                    case "mouseleave":
                        $(this).css("font-weight", "normal");
                        break;
                }                
            }                    
        })
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
